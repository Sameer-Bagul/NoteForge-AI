# Backend Environment Variables Example
# Copy this file to .env and update values as needed

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS Settings
CORS_ORIGIN=http://localhost:8080

# ─── AI Provider Configuration ──────────────────────────────────────────────────
# At least one provider must be configured and enabled via the Settings panel.
# Settings can also be managed at runtime via the /api/settings endpoint.

# Ollama (local, default)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OLLAMA_TEMPERATURE=0.7
OLLAMA_MAX_TOKENS=4000

# LM Studio (local OpenAI-compatible)
LMSTUDIO_BASE_URL=http://localhost:1234

# Google Gemini (cloud) — comma-separated for multiple keys
# GEMINI_API_KEYS=key1,key2,key3

# xAI Grok (cloud) — comma-separated for multiple keys
# GROK_API_KEYS=key1,key2

# ─── Storage Configuration ──────────────────────────────────────────────────────
STORAGE_DIR=./storage

# YouTube API (Optional - for quota management)
# YOUTUBE_API_KEY=your_api_key_here

# Logging
LOG_LEVEL=info
ENABLE_DEBUG_LOGS=true
