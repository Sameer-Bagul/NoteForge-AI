{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "NoteForge",
  "version": "0.1.0",
  "identifier": "com.noteforge.ai",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "NoteForge AI",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyRkFGRjJDNDhGN0FBODIKUldTQ3F2ZElMUC82d3FKZGdqd05TQTF3MkxjK2NUbmREeTBNRS9xZmRLcWU4SU01T1RsUndmSVUK",
      "endpoints": [
        "https://github.com/Sameer-Bagul/NoteForge-AI/releases/latest/download/latest.json"
      ]
    }
  }
}
